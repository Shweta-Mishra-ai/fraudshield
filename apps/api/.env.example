# ── Copy this to .env for local development ───────────────────────────────
# NEVER commit .env to git!

# App
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
PORT=8000

# Security — change these in production!
API_KEYS=dev-key-local-only,another-key
JWT_SECRET=super-secret-change-in-production-min-32-chars

# Rate limiting
RATE_LIMIT=1000

# Database
DB_PATH=data/fraud.db

# Pathway
PATHWAY_INPUT_DIR=data/transactions
PATHWAY_ALERTS_DIR=data/alerts
PATHWAY_MODE=streaming

# CORS — restrict in production
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000

# Optional
MODEL_VERSION=2.0.0
