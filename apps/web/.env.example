# ── Copy to .env.local for development ────────────────────────────────────
# NEVER commit .env.local to git!

# Supabase — get from supabase.com → project → settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# FraudShield API (your Render deployment)
NEXT_PUBLIC_API_URL=https://fraudshield-api.onrender.com

# Demo API key (public — limited to demo transactions only)
NEXT_PUBLIC_DEMO_API_KEY=fs_demo_key_for_landing_page

# App URL (for redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
